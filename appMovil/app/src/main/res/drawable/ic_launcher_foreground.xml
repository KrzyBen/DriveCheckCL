    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Aro del volante -->
    <path
        android:pathData="M84,54a30,30 0,1 1,-60 0a30,30 0,1 1,60 0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:fillColor="#00000000" />

    <!-- Rayo superior -->
    <path
        android:pathData="M54,40 L54,27"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Rayo inferior derecho -->
    <path
        android:pathData="M66.1,61 L77.4,67.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Rayo inferior izquierdo -->
    <path
        android:pathData="M41.9,61 L30.6,67.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Centro del volante -->
    <path
        android:pathData="M67.5,54a13.5,13.5 0,1 1,-27 0a13.5,13.5 0,1 1,27 0"
        android:fillColor="#D52B1E" />

    <!-- Check -->
    <path
        android:pathData="M49.3,54.7 L52.65,58.05 L59.75,49.6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
