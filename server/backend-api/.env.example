# ── Servidor ──────────────────────────────────────────────
HOST=localhost
PORT=8000

# ── Base de datos PostgreSQL ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
PASSWORD=postgres
DATABASE=drivecheckcl

# ── Seguridad JWT ──────────────────────────────────────────
ACCESS_TOKEN_SECRET=cambia_esto_por_un_secreto_seguro
COOKIE_KEY=cambia_esto_tambien

# ── Frontend ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
VITE_BASE_URL=http://localhost:8000/api

# ── Almacenamiento de videos/PDFs (debe coincidir con el volumen montado en docker-compose) ──
STORAGE_PATH=/storage

# ── Canal interno hacia backend-ia ─────────────────────────
BACKEND_IA_URL=http://backend-ia:8100
INTERNAL_API_KEY=cambia_esto_por_un_secreto_compartido_largo

#─── Duración Token ───────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_DAYS=30

# ── Recuperación de contraseña (envío de correo) ────────────
# Usa un correo tipo noreply
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
SMTP_FROM_NAME=DriveCheckCL
PASSWORD_RESET_CODE_EXPIRE_MINUTES=15